# Loopgate — environment variables
# Copy this file to .env and fill in your values

PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# REQUIRED for production: protect all API endpoints and the WebSocket.
# Generate a strong token: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_TOKEN=change-me-please

# CORS: leave empty for same-origin only (recommended with Tailscale/ngrok).
# Add specific origins only if you need cross-origin access.
# CORS_ORIGINS=["https://abc123.ngrok-free.app"]

# Root directory listed in the project selector.
# Defaults: ~/Documents/Projects (Windows) | ~/projects (Linux/macOS)
# PROJECTS_ROOT=/home/user/projects

# Storage backend: "memory" (default, no persistence) or "sqlite" (persists across restarts)
# STORE_BACKEND=sqlite
# SQLITE_PATH=loopgate.db
